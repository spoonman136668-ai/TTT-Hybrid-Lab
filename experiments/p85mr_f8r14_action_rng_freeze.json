  "problem": "Original CartPoleWindSCM draws wind from self.np_random, while default env.action() draws random actions from the same generator. This can alter exogenous wind draws when the default action RNG is consumed.",
  "scope": {
    "policy": "fixed_seed_random",
    "calibration_profile_count": 3,
    "episodes_per_profile": 8,
    "max_step_count": 96,
    "source_session_seed_formula": "1824000000 + 1000*profile_index + 100*policy_index + episode_index; fixed_seed_random is policy_index 1",
    "action_domain": "ttt-hybrid:f8r14:fixed_seed_random:action:v1",
    "algorithm": "SHA256(ASCII(action_domain) || byte(0) || uint64_be(calibration_session_seed) || uint16_be(step_index))",
    "action_selection": "least significant bit of first SHA256 byte, yielding integer 0 or 1",
    "prefix_stateless": true,
    "environment_rng_independent": true,
    "call_order_independent": true,
    "profile_selection_thresholds_unchanged": true,
    "existing_trial_cohorts_unchanged": true,
    "no_exogenous_wind_in_model_features": true,
    "unpaired_calibration_world_seeds": true,
    "never_relabel_original_calibration_as_paired": true
