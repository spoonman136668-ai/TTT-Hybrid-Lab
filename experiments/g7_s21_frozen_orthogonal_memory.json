  "hypothesis": "Gradient-subspace protection built from source and prior-task training gradient sketches WITHOUT any historical episode replay preserves original and intermediate skills across A→B→C→D better than matched ordinary and random-subspace fine-tuning while still acquiring new worlds.",
  "mechanism": {
    "name": "Orthogonal Episodic Gradient Sketch (OEGS)",
    "description": "Store a low-rank orthonormal basis computed via SVD of prior-task fit gradients. Project the actual AdamW parameter update into the orthogonal complement after each step. Basis for source is recorded from final 12 source steps, extended with 12 sine and 12 rational fit gradients at task boundaries. No former training episodes touched by OEGS after leaving a phase.",
    "prior_art": "Orthogonal-gradient protection and gradient projection have substantial prior art; unusual local combination is experimental, not claimed novel invention.",
    "capture_last_steps_per_family": 12,
    "svd_relative_threshold": 0.001,
    "max_total_rank": 36,
    "project_parameter_delta_after_adamw": true,
    "random_control": "identical rank and projection, but randomly oriented QR subspace from deterministic seed+7300+stage; no stored training gradients.",
    "no_replay_in_protected": true,
    "memory_accounting": true
  },
  "environment": {
